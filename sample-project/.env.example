# Copy to .env to override the defaults in docker-compose.yml.
APP_PORT=8080
APP_URL=http://localhost:8080
APP_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false

POSTGRES_DB=base
POSTGRES_USER=base
POSTGRES_PASSWORD=base

# Initial super administrator, created only when the users table is empty.
ADMIN_EMAIL=admin@exemplo.pt
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Administrador

# Initial branding and e-mail settings, written only on first start.
PROJECT_TITLE=Projeto Base
CLIENT_NAME=ENSO
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SSL=false
SMTP_IGNORE_CERTIFICATES=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@base-project.local

# Dev only: Mailpit inbox URL shown in the front-end. Set to empty (MAILPIT_URL=) in production.
MAILPIT_PORT=8025
MAILPIT_URL=http://localhost:8025

# Fingerprint login (WebAuthn). Registered fingerprints are bound to this domain: changing it later
# invalidates them. By default both are derived from APP_URL; production must be HTTPS (localhost is exempt).
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
