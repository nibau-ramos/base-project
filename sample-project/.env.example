# Copy to .env to override the defaults in docker-compose.yml.
APP_PORT=8080
APP_URL=http://localhost:8080
APP_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false

POSTGRES_DB=base
POSTGRES_USER=base
POSTGRES_PASSWORD=base

# Initial super administrator, created only when the users table is empty.
ADMIN_EMAIL=admin@exemplo.pt
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Administrador

# Initial branding and e-mail settings, written only on first start.
PROJECT_TITLE=Projeto Base
CLIENT_NAME=ENSO
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SSL=false
SMTP_IGNORE_CERTIFICATES=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@base-project.local
